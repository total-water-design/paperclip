{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.totalwater.design/assistant/v1/assistant-manifest.schema.json",
  "title": "TWDS Assistant Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "assistant_id", "display_name", "response_contract", "semantic_target_registry", "tool_registry", "capabilities"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "contract": {"const": "twds.assistant/v1"},
    "assistant_id": {"type": "string", "pattern": "^twds\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "response_contract": {"type": "string", "format": "uri-reference"},
    "semantic_target_registry": {"type": "string", "format": "uri-reference"},
    "tool_registry": {"type": "string", "format": "uri-reference"},
    "capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["explain", "navigate", "highlight", "propose_tool"]}
    },
    "tool_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}}
}
