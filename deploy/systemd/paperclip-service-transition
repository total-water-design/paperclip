#!/usr/bin/env bash
# Auditable, non-migrating transition between a named manual Paperclip process
# and the root-managed systemd unit. Production mutations require an explicit
# action; `capture` is read-only.
set -euo pipefail

fail() { printf 'paperclip transition: %s\n' "$*" >&2; exit 1; }
action="${1:-}"
evidence_dir="${PAPERCLIP_TRANSITION_EVIDENCE_DIR:-}"
instance="${PAPERCLIP_INSTANCE_ID:-default}"
unit="${PAPERCLIP_SYSTEMD_UNIT:-paperclip.service}"
rollback_root="${PAPERCLIP_ROLLBACK_ROOT:-/root/paperclip-service-rollback}"
manual_pid="${PAPERCLIP_MANUAL_PID:-}"
[[ "$instance" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "unsafe instance id"
[[ -n "$evidence_dir" && "$evidence_dir" = /* ]] || fail "set PAPERCLIP_TRANSITION_EVIDENCE_DIR to an absolute change-record directory"
mkdir -p "$evidence_dir"

record_service() {
  systemctl is-enabled "$unit" >"$evidence_dir/service.enabled" 2>&1 || true
  systemctl is-active "$unit" >"$evidence_dir/service.active" 2>&1 || true
  systemctl show "$unit" -p MainPID -p ActiveState -p SubState -p NRestarts -p ExecMainStatus --no-pager >"$evidence_dir/service.show" 2>&1 || true
}

canonical_reconcile() {
  local output="$1"
  local token_file="${PAPERCLIP_RECOVERY_TOKEN_FILE:-/etc/paperclip/recovery.token}" token
  [[ "$token_file" == "/etc/paperclip/recovery.token" && -r "$token_file" ]] || fail "dedicated recovery token is unavailable"
  token="$(cat "$token_file")"
  [[ ${#token} -ge 32 && "$token" != *[[:space:]]* ]] || fail "dedicated recovery token is invalid"
  curl -fsS --request POST --header "x-paperclip-recovery-token: $token" \
    http://127.0.0.1:3100/api/recovery/reconcile | jq -e . >"$output"
  unset token
}

case "$action" in
  capture)
    record_service
    curl -fsS http://127.0.0.1:3100/api/health | jq . >"$evidence_dir/health.before.json"
    ;;
  handoff)
    [[ "$manual_pid" =~ ^[0-9]+$ && "$manual_pid" -gt 1 ]] || fail "set PAPERCLIP_MANUAL_PID to the captured manual process"
    [[ -r "/proc/$manual_pid/cmdline" && -r "/proc/$manual_pid/environ" ]] || fail "manual PID is not inspectable"
    tr '\0' ' ' <"/proc/$manual_pid/cmdline" >"$evidence_dir/manual.cmdline"
    tr '\0' '\n' <"/proc/$manual_pid/environ" | grep -E '^(PAPERCLIP_HOME|PAPERCLIP_CONFIG|PAPERCLIP_INSTANCE_ID)=' >"$evidence_dir/manual.instance-env" || true
    grep -Eq "(^| )run( |$)" "$evidence_dir/manual.cmdline" || fail "PID is not a Paperclip run process"
    grep -Fxq "PAPERCLIP_INSTANCE_ID=$instance" "$evidence_dir/manual.instance-env" || fail "manual process does not prove named instance $instance"
    kill -TERM "$manual_pid"
    timeout 300 sh -c 'pid="$1"; while kill -0 "$pid" 2>/dev/null; do sleep 1; done' sh "$manual_pid" || fail "manual process did not stop gracefully"
    systemctl start "$unit"
    timeout 180 sh -c 'until systemctl is-active --quiet "$1" && curl -fsS http://127.0.0.1:3100/api/health | jq -e '\''.status == "ok"'\'' >/dev/null; do sleep 1; done' sh "$unit"
    record_service
    canonical_reconcile "$evidence_dir/reconciliation.handoff.json"
    journalctl -u "$unit" --since '-10 min' --no-pager >"$evidence_dir/journal.handoff.log"
    ;;
  reconcile)
    canonical_reconcile "$evidence_dir/reconciliation.json"
    ;;
  sigkill-test)
    [[ "${PAPERCLIP_ALLOW_SIGKILL_TEST:-}" == "APPROVED" ]] || fail "SIGKILL test is gated; set PAPERCLIP_ALLOW_SIGKILL_TEST=APPROVED only in the authorized window"
    before_pid="$(systemctl show "$unit" -p MainPID --value)"
    [[ "$before_pid" =~ ^[0-9]+$ && "$before_pid" -gt 1 ]] || fail "no managed main PID"
    printf '%s\n' "$before_pid" >"$evidence_dir/sigkill.before-pid"
    systemctl kill --signal=SIGKILL --kill-who=main "$unit"
    timeout 60 sh -c 'old="$1"; unit="$2"; until new=$(systemctl show "$unit" -p MainPID --value) && test "$new" -gt 1 && test "$new" != "$old" && systemctl is-active --quiet "$unit" && curl -fsS http://127.0.0.1:3100/api/health | jq -e '\''.status == "ok"'\'' >/dev/null; do sleep 1; done' sh "$before_pid" "$unit"
    record_service
    journalctl -u "$unit" --since '-10 min' --no-pager >"$evidence_dir/journal.sigkill.log"
    canonical_reconcile "$evidence_dir/reconciliation.sigkill.json"
    ;;
  *) fail "usage: $0 {capture|handoff|reconcile|sigkill-test}" ;;
esac
