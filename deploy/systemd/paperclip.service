[Unit]
Description=Paperclip control plane (root-managed)
Documentation=https://github.com/total-water-design/paperclip/blob/master/doc/ROOT-SYSTEMD-RUNBOOK.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
User=paperclip
Group=paperclip
Environment=PAPERCLIP_ENV_FILE=/etc/paperclip/paperclip.env
EnvironmentFile=/etc/paperclip/paperclip.env
EnvironmentFile=/etc/paperclip/recovery.env
ExecStartPre=/usr/lib/paperclip/paperclip-preflight
ExecStartPre=/usr/lib/paperclip/paperclip-activation-preflight
ExecStart=/bin/sh -ec 'exec "$PAPERCLIP_NODE" "$PAPERCLIP_EXECUTABLE" run --instance "$PAPERCLIP_INSTANCE_ID"'
WorkingDirectory=/home/paperclip
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=300s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/paperclip/.paperclip/instances
RuntimeDirectory=paperclip
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
