[Unit]
Description=Paperclip control plane (root-managed)
Documentation=https://github.com/total-water-design/paperclip/blob/master/doc/ROOT-SYSTEMD-RUNBOOK.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
User=paperclip
Group=paperclip
Environment=PAPERCLIP_ENV_FILE=/etc/paperclip/paperclip.env
EnvironmentFile=/etc/paperclip/paperclip.env
ExecStartPre=/usr/lib/paperclip/paperclip-preflight
ExecStartPre=/usr/lib/paperclip/paperclip-activation-preflight
ExecStart=/usr/lib/paperclip/paperclip-runtime-wrapper
WorkingDirectory=/
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=300s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperclip
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
