[Unit]
Description=Paperclip control plane (root-managed)
Documentation=https://github.com/total-water-design/paperclip/blob/master/doc/ROOT-SYSTEMD-RUNBOOK.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=all
User=paperclip
Group=paperclip
Environment=PAPERCLIP_ENV_FILE=/etc/paperclip/paperclip.env
Environment=PAPERCLIP_SYSTEM_HOME=/home/paperclip
EnvironmentFile=/etc/paperclip/paperclip.env
EnvironmentFile=/etc/paperclip/recovery.env
ExecStartPre=/usr/lib/paperclip/paperclip-preflight
ExecStart=/bin/sh -ec 'exec /home/paperclip/.local/bin/paperclipai run --instance "$PAPERCLIP_INSTANCE_ID"'
WorkingDirectory=/home/paperclip
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=300s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/paperclip/.paperclip /home/paperclip/workspaces /home/paperclip/.codex /home/paperclip/.claude
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
