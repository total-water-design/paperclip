# Total Water Design Suite v0.25 Alpha / Total RO Design v0.2 — authenticated AWS configuration
TOTALRO_DEPLOYMENT_MODE=server
TOTALRO_AUTH_ENABLED=1
TOTALRO_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
# PostgreSQL is recommended for the hosted multi-user Suite. Replace the password.
TOTALRO_DATABASE_URL=postgresql+psycopg://totalwaterdesign:REPLACE_DATABASE_PASSWORD@127.0.0.1/totalwaterdesign
# SQLite remains supported for isolated/local testing:
# TOTALRO_DATABASE_URL=sqlite:////var/lib/totalrodesign/totalrodesign.db
TOTALRO_AUTO_CREATE_DB=1
TOTALRO_ADMIN_EMAIL=admin@totalrodesign.com
TWDS_FOUNDER_NAME=Jerry Ross-Sisniega
TWDS_FOUNDER_TITLE=CEO and Founder
TWDS_FOUNDER_EMAIL=admin@totalrodesign.com

# Hosted calculation policy. CPU is authoritative; optional OpenCL is not probed.
TOTALRO_COMPUTE_MODE=cpu
TOTALRO_MAX_ENGINEERING_WORKERS=auto
CALCOSPOWER_DISABLE_GPU=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Accounts, projects, and sessions
TOTALRO_PROJECT_MAX_BYTES=8388608
TOTALRO_REGISTRATION_ENABLED=1
TOTALRO_SESSION_HOURS=8
TOTALRO_REMEMBER_DAYS=14
TOTALRO_CSRF_ENABLED=1
TOTALRO_CSRF_SECONDS=28800
TOTALRO_LOGIN_FAILURE_LIMIT=5
TOTALRO_LOGIN_LOCK_MINUTES=15
TOTALRO_PASSWORD_RESET_SECONDS=3600

# Mandatory Suite-wide two-step verification. Generate a stable Fernet key for
# TWDS_MFA_ENCRYPTION_KEY before broad enrollment and retain it securely. If it
# is omitted, the Suite can bootstrap from the strong server SECRET_KEY, but a
# dedicated stable key is preferred for independent secret rotation.
TWDS_MFA_REQUIRED=1
TWDS_MFA_ISSUER=Total Water Design Suite
TWDS_MFA_ENCRYPTION_KEY=REPLACE_WITH_STABLE_FERNET_KEY
TWDS_MFA_ATTEMPT_LIMIT=10
TWDS_MFA_ATTEMPT_WINDOW_SECONDS=300
# Pending, not-yet-verified TOTP enrollment secrets expire and are replaced.
# Existing enrolled users are unaffected by this value.
TWDS_MFA_ENROLLMENT_TTL_SECONDS=1800

# Mobile-app policy. KEEP DISABLED until signed iOS/Android shells, store URLs,
# and their server-side App Attest / Play Integrity verifiers are configured.
# The server fails closed if enforcement is enabled without required verifiers.
TOTALRO_REQUIRE_MOBILE_APP_ON_PHONE=0
TOTALRO_MOBILE_REQUIRED_PLATFORMS=ios,android
TOTALRO_MOBILE_APP_SESSION_SECONDS=28800
TOTALRO_IOS_APP_STORE_URL=
TOTALRO_ANDROID_PLAY_STORE_URL=

# Basic per-IP abuse controls for the single-process Alpha.
TOTALRO_LOGIN_IP_LIMIT=20
TOTALRO_LOGIN_IP_WINDOW_SECONDS=900
TOTALRO_REGISTRATION_IP_LIMIT=5
TOTALRO_REGISTRATION_IP_WINDOW_SECONDS=3600
TOTALRO_PASSWORD_RESET_IP_LIMIT=5
TOTALRO_PASSWORD_RESET_IP_WINDOW_SECONDS=3600

# Replace the first address with the Elastic IP before DNS launch.
TOTALRO_TRUSTED_HOSTS=18.222.135.181,totalrodesign.com,www.totalrodesign.com,127.0.0.1,localhost

# TEMPORARY: use 0 only while testing over plain HTTP by IP.
# Change to 1 immediately after HTTPS is active.
TOTALRO_COOKIE_SECURE=0
# Enable only after HTTPS is confirmed for both root and www names.
TOTALRO_HSTS_ENABLED=0

# Unified Suite feedback service. The Suite database is authoritative. Support
# emails and protected bundles are delivery/diagnostic aids, not the source of
# product-workflow truth.
TWDS_FEEDBACK_TO=support@totalrodesign.com
TWDS_FEEDBACK_OUTBOX=/var/lib/totalrodesign/feedback_outbox

# Canonical Suite SMTP identity. Reuse the existing AWS-managed
# admin@totalrodesign.com credentials. Never commit the actual credential.
TWDS_SMTP_HOST=smtp.gmail.com
TWDS_SMTP_PORT=587
TWDS_SMTP_STARTTLS=1
TWDS_SMTP_SSL=0
TWDS_SMTP_USER=admin@totalrodesign.com
TWDS_SMTP_PASSWORD=REPLACE_WITH_EXISTING_AWS_SMTP_CREDENTIAL
TWDS_SMTP_FROM=admin@totalrodesign.com

# Optional sanitized GitHub feedback mirror. Keep TWDS_GITHUB_TOKEN blank unless
# runtime issue promotion is intentionally enabled. The token is a server secret
# and must never be committed. Raw customer feedback is never written to GitHub.
TWDS_GITHUB_REPOSITORY=total-water-design/total-water-design-suite
TWDS_GITHUB_TOKEN=

# Existing authentication/transactional email service currently reads the
# legacy TOTALRO_SMTP_* variables. Point these to the same mailbox so account,
# security, feedback receipt/response, and release communications use one sender
# while legacy names remain supported.
TOTALRO_AUTH_MAIL_OUTBOX=/var/lib/totalrodesign/mail_outbox
TOTALRO_FEEDBACK_TO=support@totalrodesign.com
TOTALRO_FEEDBACK_OUTBOX=/var/lib/totalrodesign/feedback_outbox
TOTALRO_SMTP_HOST=smtp.gmail.com
TOTALRO_SMTP_PORT=587
TOTALRO_SMTP_STARTTLS=1
TOTALRO_SMTP_SSL=0
TOTALRO_SMTP_USER=admin@totalrodesign.com
TOTALRO_SMTP_PASSWORD=REPLACE_WITH_EXISTING_AWS_SMTP_CREDENTIAL
TOTALRO_SMTP_FROM=admin@totalrodesign.com

# Alpha host identity for Metrics may be supplied explicitly. If blank, the
# audited runtime attempts IMDSv2 and otherwise reports the instance type as
# unverified rather than inventing one.
TOTALRO_EC2_INSTANCE_TYPE=

# Hosted Alpha: one process preserves the current process-wide engineering
# monitor; two threads allow status polling while one calculation is active.
TOTALRO_GUNICORN_WORKERS=1
TOTALRO_GUNICORN_THREADS=2
TOTALRO_GUNICORN_TIMEOUT=600
# Legacy compatibility; TOTALRO_MAX_ENGINEERING_WORKERS governs the hosted release.
CALCOSPOWER_MAX_WORKERS=auto
